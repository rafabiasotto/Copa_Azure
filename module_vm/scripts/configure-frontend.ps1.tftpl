# Interrompe o script quando qualquer comando gerar erro
$ErrorActionPreference = "Stop"

# Evita mensagens de progresso excessivas durante downloads
$ProgressPreference = "SilentlyContinue"

# Habilita TLS 1.2 para downloads
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

# Diretórios utilizados durante a configuração da VM frontend
$logDirectory  = "C:\Terraform\Logs"
$workDirectory = "C:\Terraform\Frontend"
$certDirectory = "C:\Terraform\Certificates"
$logFile       = Join-Path $logDirectory "configure-frontend.log"

# Cria os diretórios necessários
New-Item -Path $logDirectory -ItemType Directory -Force | Out-Null
New-Item -Path $workDirectory -ItemType Directory -Force | Out-Null
New-Item -Path $certDirectory -ItemType Directory -Force | Out-Null

# Inicia o log
Start-Transcript -Path $logFile -Append

try {
    # Converte um valor recebido em Base64 pelo Terraform
    function ConvertFrom-Base64Value {
        param(
            [Parameter(Mandatory)]
            [string]$Value
        )

        return [System.Text.Encoding]::UTF8.GetString(
            [System.Convert]::FromBase64String($Value)
        )
    }

    # Exibe uma etapa formatada no log
    function Write-Step {
        param(
            [Parameter(Mandatory)]
            [string]$Message
        )

        Write-Host ""
        Write-Host "============================================================"
        Write-Host $Message -ForegroundColor Cyan
        Write-Host "============================================================"
    }

    # Faz download de um arquivo e valida o resultado
    function Invoke-FileDownload {
        param(
            [Parameter(Mandatory)]
            [string]$Uri,

            [Parameter(Mandatory)]
            [string]$Destination
        )

        if (Test-Path $Destination) {
            Remove-Item -Path $Destination -Force
        }

        try {
            Invoke-WebRequest `
                -Uri $Uri `
                -OutFile $Destination `
                -UseBasicParsing `
                -Headers @{
                    "User-Agent" = "Terraform-Azure-RunCommand"
                }
        }
        catch {
            throw "Falha ao baixar $Uri para $Destination. Erro: $($_.Exception.Message)"
        }

        if (-not (Test-Path $Destination)) {
            throw "O arquivo nao foi baixado: $Destination. URL: $Uri"
        }

        if ((Get-Item $Destination).Length -eq 0) {
            throw "O arquivo baixado esta vazio: $Destination"
        }
    }

    # Verifica se uma aplicação já está instalada no Windows
    function Test-ApplicationInstalled {
        param(
            [Parameter(Mandatory)]
            [string]$DisplayNamePattern
        )

        $registryPaths = @(
            "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*",
            "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*"
        )

        $application = Get-ItemProperty `
            -Path $registryPaths `
            -ErrorAction SilentlyContinue |
            Where-Object {
                $_.DisplayName -like $DisplayNamePattern
            } |
            Select-Object -First 1

        return $null -ne $application
    }

    # Instala silenciosamente um MSI
    function Install-MsiPackage {
        param(
            [Parameter(Mandatory)]
            [string]$MsiPath,

            [Parameter(Mandatory)]
            [string]$ApplicationName
        )

        $safeApplicationName = $ApplicationName -replace '[^a-zA-Z0-9\-]', '-'
        $msiLog = Join-Path $logDirectory "$safeApplicationName-install.log"

        $arguments = "/i `"$MsiPath`" /qn /norestart /L*v `"$msiLog`""

        $process = Start-Process `
            -FilePath "msiexec.exe" `
            -ArgumentList $arguments `
            -Wait `
            -PassThru

        if ($process.ExitCode -notin @(0, 3010, 1638)) {
            throw "Falha ao instalar $ApplicationName. ExitCode: $($process.ExitCode). Log: $msiLog"
        }

        if ($process.ExitCode -eq 3010) {
            Write-Warning "$ApplicationName foi instalado e solicitou reinicializacao."
        }

        if ($process.ExitCode -eq 1638) {
            Write-Host "Outra versao de $ApplicationName ja esta instalada." -ForegroundColor Yellow
        }
    }

    # Testa endpoint HTTP/HTTPS
    function Test-HttpEndpoint {
        param(
            [Parameter(Mandatory)]
            [string]$Uri,

            [Parameter(Mandatory)]
            [int]$Attempts,

            [Parameter(Mandatory)]
            [int]$DelaySeconds,

            [switch]$Required
        )

        for ($attempt = 1; $attempt -le $Attempts; $attempt++) {
            try {
                $response = Invoke-WebRequest `
                    -Uri $Uri `
                    -UseBasicParsing `
                    -TimeoutSec 15

                Write-Host "Endpoint respondeu com StatusCode $($response.StatusCode): $Uri" -ForegroundColor Green
                return $true
            }
            catch {
                Write-Warning "Tentativa $attempt de $Attempts falhou para $Uri`: $($_.Exception.Message)"

                if ($attempt -lt $Attempts) {
                    Start-Sleep -Seconds $DelaySeconds
                }
            }
        }

        if ($Required) {
            throw "O endpoint obrigatorio nao respondeu: $Uri"
        }

        return $false
    }

    # Recupera URLs dos pacotes
    $frontendZipUrl      = ConvertFrom-Base64Value '${frontend_zip_url_b64}'
    $urlRewriteMsiUrl    = ConvertFrom-Base64Value '${url_rewrite_msi_url_b64}'
    $arrMsiUrl           = ConvertFrom-Base64Value '${arr_msi_url_b64}'

    # Recupera configurações do site frontend
    $frontendSiteName    = ConvertFrom-Base64Value '${frontend_site_name_b64}'
    $frontendAppPoolName = ConvertFrom-Base64Value '${frontend_app_pool_name_b64}'
    $frontendAppPath     = ConvertFrom-Base64Value '${frontend_app_path_b64}'

    # Recupera configurações do backend
    $backendPrivateIp    = ConvertFrom-Base64Value '${backend_private_ip_b64}'
    $backendPlaceholder  = ConvertFrom-Base64Value '${backend_placeholder_b64}'

    # Recupera endpoints de validação
    $frontendHealthcheckPath = ConvertFrom-Base64Value '${frontend_healthcheck_path_b64}'
    $proxyHealthcheckPath    = ConvertFrom-Base64Value '${proxy_healthcheck_path_b64}'

    # Recupera configurações HTTPS
    $httpsEnabled          = [System.Convert]::ToBoolean('${frontend_https_enabled}')
    $certificatePfxBase64  = ConvertFrom-Base64Value '${certificate_pfx_base64_b64}'
    $certificatePfxPassword = ConvertFrom-Base64Value '${certificate_pfx_password_b64}'
    $certificateHostname   = ConvertFrom-Base64Value '${certificate_hostname_b64}'
    $httpsHealthcheckPath  = ConvertFrom-Base64Value '${https_healthcheck_path_b64}'

    # Recupera portas
    $frontendPort = ${frontend_port}
    $backendPort  = ${backend_port}

    # Monta URL privada do backend
    if ($backendPort -eq 80) {
        $backendUrl = "http://$backendPrivateIp"
    }
    else {
        $backendUrl = "http://$backendPrivateIp`:$backendPort"
    }

    Write-Step "Desabilitando Windows Firewall"

    # Desabilita o Windows Firewall
    Set-NetFirewallProfile `
        -Profile Domain, Private, Public `
        -Enabled False

    Write-Step "Desabilitando IE Enhanced Security Configuration"

    # Chaves do IE Enhanced Security Configuration
    $adminKey = "HKLM:\SOFTWARE\Microsoft\Active Setup\Installed Components\{A509B1A7-37EF-4b3f-8CFC-4F3A74704073}"
    $userKey  = "HKLM:\SOFTWARE\Microsoft\Active Setup\Installed Components\{A509B1A8-37EF-4b3f-8CFC-4F3A74704073}"

    if (Test-Path $adminKey) {
        Set-ItemProperty `
            -Path $adminKey `
            -Name "IsInstalled" `
            -Value 0 `
            -Force
    }

    if (Test-Path $userKey) {
        Set-ItemProperty `
            -Path $userKey `
            -Name "IsInstalled" `
            -Value 0 `
            -Force
    }

    Stop-Process `
        -Name "iexplore" `
        -Force `
        -ErrorAction SilentlyContinue

    Write-Step "Instalando IIS e recursos adicionais"

    # Recursos necessários para frontend e proxy reverso
    $iisFeatures = @(
        "Web-Server",
        "Web-WebSockets",
        "Web-Stat-Compression",
        "Web-Dyn-Compression",
        "Web-Scripting-Tools"
    )

    $iisResult = Install-WindowsFeature `
        -Name $iisFeatures `
        -IncludeManagementTools

    if (-not $iisResult.Success) {
        throw "Falha ao instalar IIS e recursos adicionais na VM frontend."
    }

    Write-Step "Instalando IIS URL Rewrite"

    # Instala URL Rewrite caso não exista
    if (-not (Test-ApplicationInstalled -DisplayNamePattern "*URL Rewrite*")) {
        $urlRewriteMsiPath = Join-Path $workDirectory "url-rewrite-x64.msi"

        Invoke-FileDownload `
            -Uri $urlRewriteMsiUrl `
            -Destination $urlRewriteMsiPath

        Install-MsiPackage `
            -MsiPath $urlRewriteMsiPath `
            -ApplicationName "IIS-URL-Rewrite"
    }
    else {
        Write-Host "IIS URL Rewrite ja esta instalado." -ForegroundColor Yellow
    }

    Write-Step "Instalando Application Request Routing"

    # Instala ARR caso não exista
    if (-not (Test-ApplicationInstalled -DisplayNamePattern "*Application Request Routing*")) {
        $arrMsiPath = Join-Path $workDirectory "application-request-routing-x64.msi"

        Invoke-FileDownload `
            -Uri $arrMsiUrl `
            -Destination $arrMsiPath

        Install-MsiPackage `
            -MsiPath $arrMsiPath `
            -ApplicationName "IIS-Application-Request-Routing"
    }
    else {
        Write-Host "Application Request Routing ja esta instalado." -ForegroundColor Yellow
    }

    Write-Step "Habilitando proxy reverso no ARR"

    # Carrega módulo de administração do IIS
    Import-Module WebAdministration -Force

    # Habilita o proxy reverso
    Set-WebConfigurationProperty `
        -PSPath "MACHINE/WEBROOT/APPHOST" `
        -Filter "system.webServer/proxy" `
        -Name "enabled" `
        -Value $true

    # Preserva o Host header
    Set-WebConfigurationProperty `
        -PSPath "MACHINE/WEBROOT/APPHOST" `
        -Filter "system.webServer/proxy" `
        -Name "preserveHostHeader" `
        -Value $false

    # Evita reescrita do host nos headers de resposta
    Set-WebConfigurationProperty `
        -PSPath "MACHINE/WEBROOT/APPHOST" `
        -Filter "system.webServer/proxy" `
        -Name "reverseRewriteHostInResponseHeaders" `
        -Value $false

    # Valida se o proxy foi habilitado
    $proxyEnabled = Get-WebConfigurationProperty `
        -PSPath "MACHINE/WEBROOT/APPHOST" `
        -Filter "system.webServer/proxy" `
        -Name "enabled"

    if (-not [System.Convert]::ToBoolean($proxyEnabled.Value)) {
        throw "O proxy do Application Request Routing nao foi habilitado."
    }

    Write-Step "Removendo configuracao anterior do frontend"

    # Caminhos IIS
    $frontendSitePath    = "IIS:\Sites\$frontendSiteName"
    $frontendAppPoolPath = "IIS:\AppPools\$frontendAppPoolName"
    $defaultSitePath     = "IIS:\Sites\Default Web Site"

    # Remove site anterior
    if (Test-Path $frontendSitePath) {
        Stop-Website `
            -Name $frontendSiteName `
            -ErrorAction SilentlyContinue

        Remove-Website `
            -Name $frontendSiteName
    }

    # Remove Application Pool anterior
    if (Test-Path $frontendAppPoolPath) {
        Stop-WebAppPool `
            -Name $frontendAppPoolName `
            -ErrorAction SilentlyContinue

        Remove-WebAppPool `
            -Name $frontendAppPoolName
    }

    # Remove Default Web Site para liberar porta 80
    if (Test-Path $defaultSitePath) {
        Stop-Website `
            -Name "Default Web Site" `
            -ErrorAction SilentlyContinue

        Remove-Website `
            -Name "Default Web Site"
    }

    Write-Step "Baixando e extraindo a aplicacao frontend"

    # Caminhos temporários
    $frontendZipPath  = Join-Path $workDirectory "fifa2026-web.zip"
    $extractDirectory = Join-Path $workDirectory "Extracted"

    if (Test-Path $extractDirectory) {
        Remove-Item `
            -Path $extractDirectory `
            -Recurse `
            -Force
    }

    New-Item `
        -Path $extractDirectory `
        -ItemType Directory `
        -Force |
        Out-Null

    # Baixa o ZIP do frontend
    Invoke-FileDownload `
        -Uri $frontendZipUrl `
        -Destination $frontendZipPath

    # Extrai o ZIP
    Expand-Archive `
        -Path $frontendZipPath `
        -DestinationPath $extractDirectory `
        -Force

    # Detecta se existe pasta raiz no ZIP
    $packagedApplicationPath = Join-Path $extractDirectory "fifa2026-web"

    if (Test-Path $packagedApplicationPath) {
        $sourceApplicationPath = $packagedApplicationPath
    }
    else {
        $sourceApplicationPath = $extractDirectory
    }

    # Remove publicação anterior
    if (Test-Path $frontendAppPath) {
        Remove-Item `
            -Path $frontendAppPath `
            -Recurse `
            -Force
    }

    # Cria pasta final do frontend
    New-Item `
        -Path $frontendAppPath `
        -ItemType Directory `
        -Force |
        Out-Null

    # Copia arquivos para a pasta do IIS
    Copy-Item `
        -Path (Join-Path $sourceApplicationPath "*") `
        -Destination $frontendAppPath `
        -Recurse `
        -Force

    # Valida arquivos obrigatórios
    $requiredApplicationItems = @(
        "index.html",
        "web.config"
    )

    foreach ($requiredItem in $requiredApplicationItems) {
        $requiredPath = Join-Path $frontendAppPath $requiredItem

        if (-not (Test-Path $requiredPath)) {
            throw "Item obrigatorio nao encontrado no pacote frontend: $requiredItem"
        }
    }

    Write-Step "Configurando endereco privado do backend no web.config"

    # Caminho do web.config
    $webConfigPath = Join-Path $frontendAppPath "web.config"

    # Lê web.config
    $webConfigContent = [System.IO.File]::ReadAllText($webConfigPath)

    # Substitui placeholder pelo backend privado
    if ($webConfigContent.Contains($backendPlaceholder)) {
        $webConfigContent = $webConfigContent.Replace(
            $backendPlaceholder,
            $backendUrl
        )

        $utf8WithoutBom = New-Object System.Text.UTF8Encoding($false)

        [System.IO.File]::WriteAllText(
            $webConfigPath,
            $webConfigContent,
            $utf8WithoutBom
        )
    }

    # Valida substituição
    $configuredWebConfig = [System.IO.File]::ReadAllText($webConfigPath)

    if ($configuredWebConfig.Contains($backendPlaceholder)) {
        throw "O placeholder $backendPlaceholder ainda existe no web.config."
    }

    if (-not $configuredWebConfig.Contains($backendUrl)) {
        throw "O endereco do backend nao foi encontrado no web.config: $backendUrl"
    }

    Write-Host "Backend configurado no proxy: $backendUrl" -ForegroundColor Green

    Write-Step "Configurando permissoes do frontend"

    # Permissão de leitura e execução para o grupo do IIS
    & icacls.exe `
        $frontendAppPath `
        /grant "IIS_IUSRS:(OI)(CI)RX" `
        /T `
        /C |
        Out-Null

    if ($LASTEXITCODE -ne 0) {
        throw "Falha ao configurar permissoes para IIS_IUSRS."
    }

    Write-Step "Criando Application Pool do frontend"

    # Cria o Application Pool
    New-WebAppPool `
        -Name $frontendAppPoolName |
        Out-Null

    # Configura No Managed Code
    Set-ItemProperty `
        -Path $frontendAppPoolPath `
        -Name "managedRuntimeVersion" `
        -Value ""

    # Inicialização automática
    Set-ItemProperty `
        -Path $frontendAppPoolPath `
        -Name "startMode" `
        -Value "AlwaysRunning"

    # Identity padrão do Application Pool
    Set-ItemProperty `
        -Path $frontendAppPoolPath `
        -Name "processModel.identityType" `
        -Value 4

    Write-Step "Criando site IIS do frontend"

    # Cria o site HTTP
    New-Website `
        -Name $frontendSiteName `
        -PhysicalPath $frontendAppPath `
        -Port $frontendPort `
        -IPAddress "*" `
        -ApplicationPool $frontendAppPoolName `
        -Force |
        Out-Null

    # Início automático do site
    Set-ItemProperty `
        -Path $frontendSitePath `
        -Name "serverAutoStart" `
        -Value $true

    # Inicia Application Pool e site
    Start-WebAppPool `
        -Name $frontendAppPoolName

    Start-Website `
        -Name $frontendSiteName

    if ($httpsEnabled) {
        Write-Step "Importando certificado PFX e configurando HTTPS"

        # Caminho local do certificado PFX
        $pfxPath = Join-Path $certDirectory "$frontendSiteName.pfx"

        # Decodifica o PFX recebido pelo Terraform
        $pfxBytes = [System.Convert]::FromBase64String($certificatePfxBase64)

        # Grava o PFX em disco
        [System.IO.File]::WriteAllBytes(
            $pfxPath,
            $pfxBytes
        )

        # Converte a senha do PFX para SecureString
        $securePassword = ConvertTo-SecureString `
            -String $certificatePfxPassword `
            -AsPlainText `
            -Force

        # Importa o certificado no repositório LocalMachine\My
        $importedCertificate = Import-PfxCertificate `
            -FilePath $pfxPath `
            -CertStoreLocation "Cert:\LocalMachine\My" `
            -Password $securePassword `
            -Exportable

        if ($null -eq $importedCertificate) {
            throw "Falha ao importar o certificado PFX."
        }

        Write-Host "Certificado importado. Thumbprint: $($importedCertificate.Thumbprint)" -ForegroundColor Green

        # Remove binding HTTPS anterior do mesmo hostname
        $existingHttpsBindings = Get-WebBinding `
            -Name $frontendSiteName `
            -Protocol "https" `
            -ErrorAction SilentlyContinue |
            Where-Object {
                $_.bindingInformation -eq "*:443:$certificateHostname"
            }

        foreach ($existingBinding in $existingHttpsBindings) {
            Remove-WebBinding `
                -Name $frontendSiteName `
                -Protocol "https" `
                -Port 443 `
                -HostHeader $certificateHostname `
                -ErrorAction SilentlyContinue
        }

        # Cria binding HTTPS com SNI
        New-WebBinding `
            -Name $frontendSiteName `
            -Protocol "https" `
            -Port 443 `
            -IPAddress "*" `
            -HostHeader $certificateHostname `
            -SslFlags 1

        # Caminho do binding SSL no IIS
        $sslBindingPath = "IIS:\SslBindings\0.0.0.0!443!$certificateHostname"

        # Remove associação anterior do certificado se existir
        if (Test-Path $sslBindingPath) {
            Remove-Item `
                -Path $sslBindingPath `
                -Force
        }

        # Associa o certificado ao binding HTTPS
        New-Item `
            -Path $sslBindingPath `
            -Thumbprint $importedCertificate.Thumbprint `
            -SSLFlags 1 |
            Out-Null

        # Cria regra de firewall local para HTTPS mesmo com firewall desativado
        if (-not (Get-NetFirewallRule -DisplayName "Allow HTTPS 443" -ErrorAction SilentlyContinue)) {
            New-NetFirewallRule `
                -DisplayName "Allow HTTPS 443" `
                -Direction Inbound `
                -Protocol TCP `
                -LocalPort 443 `
                -Action Allow |
                Out-Null
        }

        Write-Host "Binding HTTPS criado para $certificateHostname na porta 443." -ForegroundColor Green
    }

    Write-Step "Reiniciando IIS"

    # Reinicia o IIS
    & iisreset.exe /restart

    if ($LASTEXITCODE -ne 0) {
        throw "Falha ao reiniciar o IIS."
    }

    # Confirma serviço W3SVC
    $w3svc = Get-Service -Name "W3SVC"

    if ($w3svc.Status -ne "Running") {
        Start-Service -Name "W3SVC"
    }

    # Confirma site iniciado
    $website = Get-Website -Name $frontendSiteName

    if ($website.State -ne "Started") {
        Start-Website -Name $frontendSiteName
    }

    # Monta URL local HTTP
    if ($frontendPort -eq 80) {
        $frontendBaseUrl = "http://localhost"
    }
    else {
        $frontendBaseUrl = "http://localhost`:$frontendPort"
    }

    Write-Step "Executando smoke test HTTP do frontend"

    # Testa página principal HTTP
    $frontendHealthcheckUri = "$frontendBaseUrl$frontendHealthcheckPath"

    Test-HttpEndpoint `
        -Uri $frontendHealthcheckUri `
        -Attempts 12 `
        -DelaySeconds 10 `
        -Required |
        Out-Null

    Write-Step "Executando smoke test HTTP do proxy para o backend"

    # Testa proxy HTTP para backend
    $proxyHealthcheckUri = "$frontendBaseUrl$proxyHealthcheckPath"

    $proxySucceeded = Test-HttpEndpoint `
        -Uri $proxyHealthcheckUri `
        -Attempts 12 `
        -DelaySeconds 10

    if (-not $proxySucceeded) {
        Write-Warning "O frontend foi instalado, mas o proxy ainda nao respondeu em $proxyHealthcheckUri."
        Write-Warning "Verifique a VM backend, o banco, a NSG e o peering."
    }

    if ($httpsEnabled) {
        Write-Step "Validando configuracao HTTPS no IIS"

        # Valida se o binding HTTPS foi criado
        $httpsBinding = Get-WebBinding `
            -Name $frontendSiteName `
            -Protocol "https" |
            Where-Object {
                $_.bindingInformation -eq "*:443:$certificateHostname"
            }

        if ($null -eq $httpsBinding) {
            throw "Binding HTTPS nao encontrado para $certificateHostname."
        }

        # Exibe URL final esperada
        $httpsUrl = "https://$certificateHostname$httpsHealthcheckPath"

        Write-Host "HTTPS configurado. URL esperada: $httpsUrl" -ForegroundColor Green
    }

    Write-Step "Configuracao da VM frontend concluida"

    # Resumo
    Write-Host "Site: $frontendSiteName" -ForegroundColor Green
    Write-Host "Application Pool: $frontendAppPoolName" -ForegroundColor Green
    Write-Host "Diretorio: $frontendAppPath" -ForegroundColor Green
    Write-Host "Backend privado: $backendUrl" -ForegroundColor Green
    Write-Host "Proxy ARR habilitado: $($proxyEnabled.Value)" -ForegroundColor Green
    Write-Host "HTTPS habilitado: $httpsEnabled" -ForegroundColor Green

    if ($httpsEnabled) {
        Write-Host "Hostname HTTPS: $certificateHostname" -ForegroundColor Green
    }

    Write-Host "Log: $logFile" -ForegroundColor Green
}
catch {
    # Registra erro e faz a extensão falhar
    Write-Error "Falha na configuracao da VM frontend: $($_.Exception.Message)"
    throw
}
finally {
    # Encerra log
    Stop-Transcript -ErrorAction SilentlyContinue
}